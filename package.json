{
  "name": "asterbyte-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "esbuild": false,
    "cloudflared@0.7.3": true
  },
  "scripts": {
    "dev": "npm run build --workspace @asterbyte/contracts && concurrently --kill-others --names contracts,api,web \"npm run dev --workspace @asterbyte/contracts\" \"npm run dev --workspace @asterbyte/api\" \"npm run dev --workspace @asterbyte/web\"",
    "build": "npm run build --workspace @asterbyte/contracts && npm run build --workspace @asterbyte/api && npm run build --workspace @asterbyte/web",
    "start": "npm run start --workspace @asterbyte/api",
    "typecheck": "npm run build --workspace @asterbyte/contracts && tsc -p scripts/database/tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --workspace @asterbyte/contracts && npm run test:database && npm run test --workspaces --if-present",
    "test:database": "vitest run --config scripts/database/vitest.config.ts",
    "db:validate": "tsx scripts/database/cli.ts validate",
    "db:seed:sql": "tsx scripts/database/cli.ts seed-sql",
    "db:verify:sql": "tsx scripts/database/cli.ts verify-sql",
    "db:verify:rest": "tsx scripts/database/verify-rest.ts",
    "knowledge:ingest": "tsx scripts/database/knowledge.ts",
    "knowledge:verify": "tsx scripts/database/verify-runtime.ts",
    "bolna:config": "tsx scripts/database/bolna-config.ts",
    "integrations:secrets": "tsx scripts/database/prepare-secrets.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:dev": "npm run build --workspace @asterbyte/contracts && node scripts/smoke.mjs --dev",
    "review:frontend": "npm run build --workspace @asterbyte/contracts && node scripts/visual-review.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "cloudflared": "0.7.3"
  }
}
