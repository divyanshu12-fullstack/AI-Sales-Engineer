# Copy to .env at the workspace root. Blank entries use documented defaults or
# leave the integration unavailable. Never put credentials in VITE_* variables.
# Defaults: development, 127.0.0.1, 3001, http://127.0.0.1:5173, info, 120.
NODE_ENV=
HOST=
PORT=
# Production browser origin: https://asterbyte.divyanshu.engineer
WEB_ORIGIN=
LOG_LEVEL=
RATE_LIMIT_MAX=

# Development database/API configuration. Secret key is backend-only; publishable key
# may be returned by /api/auth/config for administrator sign-in.
# SUPABASE_URL is the API origin, not a PostgreSQL migration connection string.
# These values remain server-side. Developer MCP authenticates separately through OAuth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Bolna integration; tool and webhook credentials must be DIFFERENT,
# randomly generated secrets of at least 32 characters, stored only server-side
# and in the provider's API/header configuration, never in agent prompts.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Used only when an execution has no telephony provider metadata: browser or phone.
BOLNA_CALL_CHANNEL=
# Public browser session minting. Existing agent configuration is never changed.
# Enabled by default when the account key and agent ID are configured. Set false to disable.
BOLNA_WEB_CALL_ENABLED=true
# Per-IP session attempts per 10 minutes; default 3, global single-process ceiling 20.
BOLNA_SESSION_RATE_LIMIT=3
BOLNA_TOOL_AUTH_TOKEN=
BOLNA_WEBHOOK_SECRET=

# Bolna's conversational model remains in Bolna, not controlled by the LLM variables here.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=openrouter
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Optional server-only Google Calendar sync, triggered only after a customer confirms.
# Use personal-Gmail OAuth; never put these credentials in frontend/VITE_* settings.
# In Google Cloud, enable Calendar API, configure an External consent screen, and
# publish it In production. Create a Web OAuth client with redirect URI
# https://developers.google.com/oauthplayground, then use OAuth Playground with
# your client ID/secret to authorize calendar.events and exchange for a refresh token.
# Do not request calendar.freebusy: this app checks availability from its own database.
CALENDAR_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# Contact address for privacy and data-deletion requests.
PRIVACY_CONTACT_EMAIL=

# Sender is a plain email address on a domain verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Background support and consultation email retries. Test-only owned servers set false.
SUPPORT_EMAIL_WORKER_ENABLED=true
# Optional 32+ character secret used to derive unguessable consultation-confirmation
# links. Falls back to the server-only Supabase secret. Rotating it invalidates
# previously emailed links.
MEETING_CONFIRMATION_SECRET=

# Public callback origin for Bolna: HTTPS only, no path/query/credentials.
# Production value: https://asterbyte.divyanshu.engineer
# Merely setting this does not establish callback reachability.
PUBLIC_API_BASE_URL=
