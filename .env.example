# Copy to .env at the workspace root. Blank entries use documented defaults or
# leave the integration unavailable. Never put credentials in VITE_* variables.
# Defaults: development, 127.0.0.1, 3001, http://127.0.0.1:5173, info, 120.
NODE_ENV=
HOST=
PORT=
WEB_ORIGIN=
LOG_LEVEL=
RATE_LIMIT_MAX=

# Development database/API configuration; runtime clients/Auth are separate milestones.
# SUPABASE_URL is the API origin, not a PostgreSQL migration connection string.
# These values remain server-side. Developer MCP authenticates separately through OAuth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Future Bolna integration; tool and webhook credentials must be DIFFERENT,
# randomly generated secrets of at least 32 characters, stored only server-side
# and in the provider's API/header configuration, never in agent prompts.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_TOOL_AUTH_TOKEN=
BOLNA_WEBHOOK_SECRET=

# Provider selection and model names are intentionally not defaulted.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Cal.com is the proposed calendar adapter, not an implemented integration.
# Supported configuration selector: calcom. Event type ID is a positive integer.
CALENDAR_PROVIDER=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Sender is a plain email address on a domain verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Future public callback origin: HTTPS only, no path, query, or credentials.
# Merely setting this does not establish callback reachability.
PUBLIC_API_BASE_URL=
